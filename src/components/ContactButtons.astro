---
import { contacts, site } from '../config/site';
const channels = [
  { label: 'Cotizar por WhatsApp', short: 'WhatsApp', icon: 'chat', hint: site.phoneDisplay },
  { label: 'Instagram', short: 'Instagram', icon: 'camera', hint: 'Conoce nuestras plantas' },
  { label: 'Facebook', short: 'Facebook', icon: 'facebook', hint: 'Visita nuestra página' },
  { label: 'Escríbenos por correo', short: 'Correo', icon: 'mail', hint: site.email },
];
const paths: Record<string, string> = {
  chat: 'M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5ZM9 7l-1 2c1 4 3 6 7 7l2-1-3-2-1 1-3-3 1-1-2-3Z',
  camera: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm9 9a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm1-5h.01',
  facebook: 'M14 21v-8h3l.5-4H14V7c0-1 .5-2 2-2h2V2h-3c-3 0-5 2-5 5v2H7v4h3v8',
  mail: 'M3 5h18v14H3V5Zm0 1 9 7 9-7',
};
---
<div class="contact-buttons">
  {channels.map(channel => {
    const contact = contacts.find(item => item.label === channel.label);
    return (contact || import.meta.env.DEV) && <a class:list={['channel', { primary: channel.icon === 'chat', pending: !contact }]} href={contact?.href} aria-disabled={!contact ? 'true' : undefined} target={contact?.href.startsWith('https:') ? '_blank' : undefined} rel={contact ? 'noopener noreferrer' : undefined}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[channel.icon]} /></svg>
      <span><strong>{channel.icon === 'chat' ? channel.label : channel.short}</strong><small>{contact ? channel.hint : 'Pendiente de configurar'}</small></span>
      {contact && <span class="channel-arrow" aria-hidden="true">↗</span>}
    </a>;
  })}
</div>
{contacts.length === 0 && !import.meta.env.DEV && <p class="contact-empty">Pronto compartiremos nuestros canales de contacto.</p>}
