---
import { existsSync } from 'node:fs';
import photos from '../../data/catalogo_fotografico.json';
import { site, publicUrl } from '../config/site';
import '../styles/simple.css';
import ContactButtons from '../components/ContactButtons.astro';
import SocialLinks from '../components/SocialLinks.astro';
const logo = existsSync('public/logo.png');
const photo = (index: number) => photos[index];
const image = (index: number) => '/' + photo(index).foto_web;
const categories = [
  { id: 'flores', title: 'Flores y ornamentales' },
  { id: 'suculentas', title: 'Suculentas' },
  { id: 'follajes', title: 'Cóleos y follajes' },
  { id: 'vivero', title: 'Nuestro vivero' },
];
const title = "Celi's Viveros | Vivero y plantas ornamentales en La Cruz";
const description = 'Plantas ornamentales, flores y suculentas en San Jorge, La Cruz, provincia de Quillota. Visita el vivero y consulta disponibilidad y ventas mayoristas.';
const missing = Object.entries(site).filter(([key, value]) => key !== 'name' && !value).map(([key]) => key);
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} /><meta name="theme-color" content="#203f30" />
    <link rel="icon" href="/favicon-vivero.png" type="image/png" sizes="64x64" />
    {publicUrl && <link rel="canonical" href={`${publicUrl}/`} />}
    <meta property="og:type" content="website" /><meta property="og:locale" content="es_CL" />
    <meta property="og:title" content="Celi’s Viveros · Desde Pocochay, con raíces" /><meta property="og:description" content={description} />
    {publicUrl && <><meta property="og:url" content={`${publicUrl}/`} /><meta property="og:image" content={`${publicUrl}${image(1)}`} /></>}
    <meta property="og:image:alt" content={photo(1).alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${publicUrl}${image(1)}`} />
    <meta name="twitter:image:alt" content={photo(1).alt} />
    <meta property="og:site_name" content={site.name} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'GardenStore', '@id': `${publicUrl}/#business`,
      name: site.name, url: `${publicUrl}/`, description, telephone: `+${site.whatsappNumber}`, email: site.email,
      image: `${publicUrl}${image(1)}`, ...(logo ? { logo: `${publicUrl}/logo.png` } : {}),
      sameAs: [site.facebookUrl, site.instagramUrl],
      address: { '@type': 'PostalAddress', streetAddress: site.streetAddress, addressLocality: site.addressLocality, addressRegion: site.addressRegion, addressCountry: 'CL' },
      openingHoursSpecification: site.openingHoursSpecification,
    }).replace(/</g, '\u003c')} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="wrap header" id="inicio">
      <a class="header-logo" href="#inicio" aria-label="Celi’s Viveros, inicio">{logo ? <img src="/logo.png" alt="Celi’s Viveros" width="1122" height="1402" /> : <span>Celi’s Viveros</span>}</a>
      <div class="header-actions"><nav aria-label="Navegación principal"><a href="#plantas">Nuestras plantas</a><a href="#contacto">Contacto <span aria-hidden="true">↗</span></a></nav><SocialLinks /></div>
    </header>
    <main id="contenido">
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow">POCOCHAY · LA CRUZ</p>
          <h1>Vivero de plantas ornamentales en La Cruz, Quillota</h1>
          <p class="slogan">Un poquito de verde. <em>Muchas posibilidades.</em></p>
          <p class="intro">Producimos y vendemos plantas ornamentales, flores de temporada, suculentas, hierbas y plantines, según disponibilidad. Recibimos a particulares y compradores mayoristas en San Jorge, La Cruz, en la Región de Valparaíso.</p>
          <div id="contacto" class="hero-contact"><h2>Conversemos</h2><ContactButtons /></div>
          <address class="business-details">
            <a href={`tel:+${site.whatsappNumber}`}><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 3 3 5-2 2a15 15 0 0 0 5 5l2-2 5 3-1 4C11 22 2 13 4 4l4-1Z" /></svg><span>{site.phoneDisplay}</span></a>
            <a href={`mailto:${site.email}`}><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18v14H3V5Zm0 1 9 7 9-7" /></svg><span>{site.email}</span></a>
            <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Celi's Viveros, " + site.addressDisplay + ', Chile')}`} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg><span>{site.addressDisplay}<small>Ver Celi’s Viveros en Google Maps ↗</small></span></a>
          </address>
          <a class="explore" href="#plantas">Conoce nuestras plantas <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-visual">
          <img class="nursery-photo" src={image(1)} alt={photo(1).alt} width="1080" height="1440" fetchpriority="high" />
          <div class="logo-card">{logo ? <img src="/logo.png" alt="Logo de Celi’s Viveros" width="1122" height="1402" /> : <span>Celi’s Viveros</span>}</div>
          <span class="photo-label">Cultivado en Pocochay <span aria-hidden="true">✿</span></span>
        </div>
      </section>
      <section class="plants wrap" id="plantas">
        <div class="section-heading"><h2>Nuestras <em>plantas.</em></h2><p>Flores, ornamentales y suculentas de nuestro vivero. Fotos reales; toca una para ampliar.</p></div>
        <div class="catalog-filters" role="group" aria-label="Filtrar catálogo">
          <button type="button" data-filter="todas" aria-pressed="true" aria-controls="catalog-results">Todas <span>{photos.length}</span></button>
          {categories.map(category => <button type="button" data-filter={category.id} aria-pressed="false" aria-controls="catalog-results">{category.title} <span>{photos.filter(item => item.categoria_catalogo === category.id).length}</span></button>)}
        </div>
        <p class="catalog-status" aria-live="polite" aria-atomic="true">{photos.length} fotografías</p>
        <div id="catalog-results">{categories.map(category => <section class="catalog-group" data-group={category.id} aria-labelledby={`heading-${category.id}`}>
          <h3 class="catalog-heading" id={`heading-${category.id}`}>{category.title}</h3>
          <div class="category-grid">{photos.filter(item => item.categoria_catalogo === category.id).map(item => <article class="category" data-photo-id={item.id}>
            <button type="button" class="photo-button" data-photo={'/' + item.foto_web} data-caption={item.titulo_catalogo} aria-label={`Ampliar: ${item.titulo_catalogo}`}><img src={'/assets/miniaturas/' + item.foto_web.split('/').pop()} alt={item.alt} width="600" height={item.id === 'foto-028' ? 450 : 800} loading="lazy" decoding="async" /><span class="expand" aria-hidden="true">↗</span></button>
            <h4>{item.titulo_catalogo}</h4>
          </article>)}</div>
        </section>)}</div>
        <p class="note">Especies, variedades y disponibilidad a confirmar al consultar.</p>
      </section>
      <section class="wholesale wrap" id="mayoristas"><div><span class="eyebrow">PARA TU NEGOCIO O PROYECTO</span><h2>¿Buscas plantas al por mayor?</h2><p>Celi’s Viveros atiende consultas de viveros, paisajistas y revendedores interesados en adquirir plantas ornamentales por volumen. Consulta especies, formatos y disponibilidad directamente con nosotros.</p></div><a class="button" href="#contacto">Conversemos <span aria-hidden="true">↗</span></a></section>
      <section class="plants wrap" id="ubicacion" aria-labelledby="ubicacion-titulo">
        <h2 id="ubicacion-titulo">Ubicación y horarios</h2>
        <p>Visítanos en {site.addressDisplay}, Chile. Estamos en el sector de San Jorge / Pocochay, en la provincia de Quillota.</p>
        <p>{site.hoursDisplay}</p>
        <p>Atención presencial y retiro en vivero. Antes de venir desde Quillota u otras comunas, consulta por WhatsApp las especies, formatos y disponibilidad.</p>
        <a class="button" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.name + ', ' + site.addressDisplay + ', Chile')}`} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
      </section>
    </main>
    <footer class="wrap"><a class="footer-logo" href="#inicio" aria-label="Celi’s Viveros, inicio"><img src="/logo.png" alt="Celi’s Viveros" width="1122" height="1402" loading="lazy" /></a><p>{site.addressDisplay}</p><SocialLinks /><small>© {new Date().getFullYear()}</small></footer>
    {import.meta.env.DEV && missing.length > 0 && <aside class="dev-notice"><strong>Vista local:</strong> los contactos pendientes se activan al completar <code>src/config/site.ts</code>. No se muestran en producción.</aside>}
    <dialog aria-labelledby="photo-caption" id="lightbox"><button class="close" autofocus aria-label="Cerrar fotografía">Cerrar ×</button><img id="large-photo" alt="" /><p id="photo-caption"></p></dialog>
    <script>
      const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const groups = document.querySelectorAll<HTMLElement>('[data-group]');
      const status = document.querySelector<HTMLElement>('.catalog-status')!;
      filters.forEach(filter => filter.addEventListener('click', () => {
        filters.forEach(button => button.setAttribute('aria-pressed', String(button === filter)));
        let count = 0;
        groups.forEach(group => {
          group.hidden = filter.dataset.filter !== 'todas' && group.dataset.group !== filter.dataset.filter;
          if (!group.hidden) count += group.querySelectorAll('[data-photo-id]').length;
        });
        status.textContent = `${count} ${count === 1 ? 'fotografía' : 'fotografías'}`;
      }));
      const dialog = document.querySelector<HTMLDialogElement>('#lightbox')!;
      const large = document.querySelector<HTMLImageElement>('#large-photo')!;
      const caption = document.querySelector('#photo-caption')!;
      document.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach(button => button.addEventListener('click', () => {
        large.src = button.dataset.photo!;
        large.alt = button.querySelector('img')?.alt || '';
        caption.textContent = button.dataset.caption || '';
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      }));
      dialog.querySelector('button')!.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', event => { if (event.target === dialog) { const r = dialog.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) dialog.close(); } });
      dialog.addEventListener('close', () => { document.body.style.overflow = ''; });
    </script>
  </body>
</html>
